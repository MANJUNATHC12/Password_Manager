# ==============================================================
# Backend Environment Configuration
# ==============================================================

# Application
ENVIRONMENT=production
DEBUG=false
APP_NAME="Password Manager"
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# Render automatically provides this if using Render Blueprint/PostgreSQL:
DATABASE_URL=postgresql+asyncpg://password_manager:password@localhost:5432/password_manager

# Security & JWT Tokens
# Generate a strong 32+ character random string (e.g. using `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: Set to your Vercel deployment URL (e.g. https://password-manager.vercel.app)
# or "*" to allow any domain
CORS_ORIGINS="*"
